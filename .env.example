# Copy to .env for local development. Use the same values as SUPABASE_URL and
# SUPABASE_ANON_KEY in the iOS app's build settings.
# The anon key is public by design (it ships in every client); your Row Level
# Security policies are what protect the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
